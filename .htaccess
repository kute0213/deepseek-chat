Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On

# API 统一入口
RewriteRule ^api/ index.php [L,QSA]

# 已存在的文件/目录直接返回
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 缺失的静态资源直接 404，交给 ErrorDocument
RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{1,8}$
RewriteRule ^ - [R=404,L]

# SPA 回退
RewriteRule ^ index.html [L]

# 内部目录与杂物禁止访问
RedirectMatch 403 ^/(app|config|storage|database|docs|frontend|scripts)(/|$)
RedirectMatch 403 ^/\.(git|gitignore)
